# ==========================================
# AURA OS - PRODUCTION ENVIRONMENT VARIABLES
# ==========================================
# Rename this file to '.env' and fill in the values below.

# 1. DATABASE
# Get a free PostgreSQL database URL from Supabase (supabase.com) or Neon (neon.tech)
# Example: postgresql://postgres:password@db.supabase.co:5432/postgres
DATABASE_URL="postgresql://username:password@host:5432/database?sslmode=require"

# 2. NEXTAUTH SECRETS
# Generate a secure random string (e.g. run 'openssl rand -base64 32' in terminal)
NEXTAUTH_SECRET="your-super-secret-key-here"
NEXTAUTH_URL="http://localhost:3000" # Change to your Vercel URL in production

# 3. GOOGLE OAUTH
# Get these from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# 4. APPLE OAUTH
# Get these from Apple Developer Portal
APPLE_ID=""
APPLE_SECRET=""

# 5. STRIPE PAYMENTS
# Get these from Stripe Dashboard -> Developers -> API Keys
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# 6. AI PROVIDERS
# Choose your AI provider and fill in the key
OPENAI_API_KEY=""
GEMINI_API_KEY=""
# NVIDIA NIM is used first by Aura Code when this key is present.
NVIDIA_API_KEY=""
# Optional: Aura Code defaults to this reasoning model.
NVIDIA_MODEL="nvidia/nemotron-3-nano-omni-30b-a3b-reasoning"
NVIDIA_MAX_TOKENS="65536"
NVIDIA_REASONING_BUDGET="16384"

# 7. EMAIL VERIFICATION (FREE GMAIL SMTP)
# Use your free Gmail account and generate a 16-letter App Password
# Instructions: https://myaccount.google.com/apppasswords
GMAIL_USER="your-email@gmail.com"
GMAIL_APP_PASSWORD="your-16-letter-app-password"
